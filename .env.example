# Copy to `.env` to override defaults locally. All values are optional.

# Embeddings / reranker: "real" (Hugging Face models) or "fake" (offline).
EMBED_BACKEND=real
RERANK_BACKEND=real

# Vector DB: empty = in-memory Qdrant; or point at a running server.
QDRANT_URL=

# Downstream LLM: "auto" | "ollama" | "extractive".
LLM_BACKEND=auto
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
